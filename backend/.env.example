# Backend Configuration
DATABASE_URL=postgresql+asyncpg://anpr_user:anpr_pass@postgres:5432/anpr_db
REDIS_URL=redis://redis:6379
ML_SERVICE_URL=http://ml-service:8001

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://frontend:3000"]

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# ANPR Settings
OCR_CONFIDENCE_THRESHOLD=0.7
FUZZY_MATCH_THRESHOLD=1
PLATE_NORMALIZATION_REGEX='^[A-Z]{2}[0-9]{2}[A-Z]{1,2}[0-9]{4}$'

# Alert Settings
BLACKLIST_FUZZY_THRESHOLD=1
CONGESTION_ZSCORE_THRESHOLD=2.0
ANOMALY_SPEED_THRESHOLD_KMPH=120

# WebSocket
WS_HEARTBEAT_INTERVAL=30