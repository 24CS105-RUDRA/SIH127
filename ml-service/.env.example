ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8001

# Model paths
YOLO_MODEL_PATH=/app/weights/yolov8n.pt
PADDLE_OCR_DET_MODEL_DIR=/app/weights/paddleocr/det
PADDLE_OCR_REC_MODEL_DIR=/app/weights/paddleocr/rec
PADDLE_OCR_CLS_MODEL_DIR=/app/weights/paddleocr/cls

# Inference settings
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
MAX_DETECTIONS=100

# Preprocessing
ENABLE_CLAHE=True
ENABLE_DEBLUR=False
ENABLE_SUPER_RES=False

# Device
DEVICE=cpu  # or cuda:0